{
  "name": "@prestamos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrar": "wrangler d1 migrations apply prestamos --local",
    "db:migrar:remoto": "wrangler d1 migrations apply prestamos --remote",
    "dev:e2e": "node e2e/preparar-base.mjs && vite --mode e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prestamos/core": "0.1.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/vitest-plugin": "^1.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.145.0"
  }
}
