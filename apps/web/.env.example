# Copia este archivo a .env.local.
# Local (npm run db:start): la URL y la publishable key que imprime `supabase start`.
# Producción: Project Settings → API Keys → Publishable key (es pública; la protege RLS).
VITE_SUPABASE_URL=http://127.0.0.1:55621
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Muestra "Entrar con Google" y "Vincular Google" solo cuando el proveedor está configurado.
VITE_GOOGLE_HABILITADO=false
