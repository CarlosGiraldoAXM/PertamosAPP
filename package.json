{
  "name": "prestamos",
  "private": true,
  "workspaces": [
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:integracion": "npm run test:integracion -w @prestamos/integracion",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "crear-admin": "node scripts/crear-admin.mjs"
  },
  "devDependencies": {
    "supabase": "^2.117.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
