{
  "name": "prestamos",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @prestamos/web",
    "build": "npm run build -w @prestamos/web",
    "deploy": "npm run deploy -w @prestamos/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @prestamos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrar": "npm run db:migrar -w @prestamos/web"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^8.3.0"
  }
}
